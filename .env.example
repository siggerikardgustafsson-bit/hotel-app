# ============================================================
# Kopiera den här filen till .env.local och fyll i värdena.
# Fyll i de FAKTISKA hemliga värdena – kommittera aldrig .env.local.
# ============================================================

# ------------------------------------------------------------
# REACT-APPEN (klient) — Vercel: Environment Variables
# Hitta dessa i: Supabase → Project Settings → API
# OBS: REACT_APP_-prefixet krävs av Create React App och dessa
# värden blir publika i bundlen (anon-nyckeln är säker att exponera).
# ------------------------------------------------------------
REACT_APP_SUPABASE_URL=https://DITT_PROJEKT_ID.supabase.co
REACT_APP_SUPABASE_ANON_KEY=din_anon_key_här
REACT_APP_ADMIN_EMAIL=din@email.se

# ------------------------------------------------------------
# LAGER 1 – MEJLPARSER (Vercel Edge Function api/inbound-email.ts)
# Sätts i: Vercel → Project → Settings → Environment Variables
# Dessa är SERVER-side och får ALDRIG ha REACT_APP_-prefix.
# ------------------------------------------------------------
SUPABASE_URL=https://DITT_PROJEKT_ID.supabase.co
# service_role-nyckel (Supabase → Project Settings → API). HEMLIG!
SUPABASE_SERVICE_ROLE_KEY=din_service_role_key_här
# Delad hemlighet som läggs i Postmark-webhookens URL (?secret=...)
# Generera valfri lång slumpsträng, t.ex. `openssl rand -hex 24`
POSTMARK_WEBHOOK_SECRET=valfri_lång_slumpsträng

# ------------------------------------------------------------
# LAGER 3 – ICAL-FALLBACK (Supabase Edge Function ical-sync)
# Sätts i: supabase secrets set BOOKING_ICAL_URL="..."
# (SUPABASE_URL och SUPABASE_SERVICE_ROLE_KEY injiceras automatiskt
#  i Supabase edge runtime – behöver INTE sättas där.)
# ------------------------------------------------------------
BOOKING_ICAL_URL=https://admin.booking.com/hotel/hoteladmin/ical.html?t=DIN_TOKEN
